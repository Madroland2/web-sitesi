generator client {
  provider = "prisma-client-js"
  // native              → geliştirenin makinesi (macOS)
  // debian-openssl-3.0.x → yerel Docker (node:20-slim)
  // rhel-openssl-3.0.x   → Vercel çalışma ortamı
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Uygulama çalışırken havuzlanmış (pooler) adres kullanılır — sunucusuz
  // ortamda her istek yeni bağlantı açarsa havuz tükenir.
  url      = env("DATABASE_URL")
  // Migration ve introspection havuzdan geçemez, doğrudan bağlantı ister.
  // Neon bu adresi DATABASE_URL_UNPOOLED olarak verir.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Post {
  id          Int      @id @default(autoincrement())
  baslik      String
  slug        String   @unique
  ozet        String
  /// Zengin metin editöründen gelen HTML. Gösterilmeden önce sanitize edilir.
  icerik      String
  kapakGorsel String?
  yayinda     Boolean  @default(false)
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([yayinda, olusturuldu])
}

/// Sol paneldeki duyuru listesi
model Duyuru {
  id          Int      @id @default(autoincrement())
  baslik      String
  /// Düz metin — duyurular kısa tutulduğu için editör kullanılmıyor
  icerik      String
  /// Boşsa duyuru yalnızca metin olarak görünür
  baglanti    String?
  yayinda     Boolean  @default(true)
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([yayinda, olusturuldu])
}

/// Görseller galerisi
model Gorsel {
  id          Int      @id @default(autoincrement())
  baslik      String
  /// Vercel Blob üzerindeki dosyanın genel adresi
  url         String
  /// Ekran okuyucular için açıklama
  altMetin    String?
  yayinda     Boolean  @default(true)
  /// Küçükten büyüğe sıralanır; eşitse tarihe göre
  sira        Int      @default(0)
  olusturuldu DateTime @default(now())
  guncellendi DateTime @updatedAt

  @@index([yayinda, sira])
}
