# ── Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun ──
# cp .env.example .env.local

# Veritabanı bağlantısı (PostgreSQL)
#   Yerel Docker geliştirme  : docker-compose bunu kendi veriyor, elle gerekmez
#   Vercel / üretim          : Neon, Supabase veya Vercel Postgres bağlantı dizesi
# Not: Vercel gibi sunucusuz ortamlarda bağlantı havuzlayan (pooled) adresi kullanın.
DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani?sslmode=require"

# Oturum çerezini şifreleyen anahtar — en az 32 karakter, rastgele
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Admin şifresinin bcrypt özeti
# Üretmek için: node -e "require('bcryptjs').hash('SIFRENIZ',12).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=""
